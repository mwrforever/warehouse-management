# ============================================================
# warehouse 后端环境配置示例
# 使用方法：cp .env.example .env 后执行 php artisan key:generate
# 生产部署必读：APP_ENV=production + APP_DEBUG=false + 强 APP_KEY + 强 ADMIN_PASSWORD
# ============================================================

# ===== 应用基础 =====
# 应用名称（邮件发件人名称、前端标题等处展示；含空格必须加引号）
APP_NAME=warehouse
# 运行环境：local=开发 / production=生产（生产必须 production）
APP_ENV=local
# 应用密钥：php artisan key:generate 生成；生产必须唯一且严格保密（泄露可伪造会话/解密敏感数据）
APP_KEY=
# 调试开关：生产必须 false（否则错误堆栈与敏感信息直接暴露给用户）
APP_DEBUG=true
# 后端对外访问地址（前端 vite 代理 /api → 127.0.0.1:8000；生产改为实际域名）
APP_URL=http://localhost:8000

# 默认语言（界面文案在前端为中文；Laravel 侧本地化备用）
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# 维护模式存储驱动（file 即可；database 需先迁移 maintenance 表）
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP 内置开发服务器并发数（php artisan serve 时生效）
# PHP_CLI_SERVER_WORKERS=4

# bcrypt 哈希强度（12 为默认；测试环境由 phpunit.xml 覆盖为 4 加速）
BCRYPT_ROUNDS=12

# ===== 日志 =====
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 日志级别：debug=开发全量 / 生产建议 warning 以上（减少磁盘占用与敏感信息落盘）
LOG_LEVEL=debug

# ===== 数据库（默认 MySQL 8.4，与 docker-compose.yml 编排一致）=====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# 库名/账号/口令（与 docker-compose.yml 一致）；单元测试与 E2E 用 SQLite（phpunit.xml / playwright webServer），不读本项
DB_DATABASE=php_design
DB_USERNAME=php
DB_PASSWORD=secret

# ===== 会话（database 驱动：sessions 表，多实例共享、重启不丢失）=====
SESSION_DRIVER=database
# 会话有效期（分钟）
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# 会话 Cookie 域名：null=当前域；多子域共享登录态时设为父域
SESSION_DOMAIN=null

# ===== Sanctum SPA 会话鉴权（R4-3）=====
# 允许走 cookie 会话鉴权（session 通道）的前端源列表，按请求 Referer/Origin 通配匹配、逗号分隔、不含协议。
# 4000=Vite 前端开发服务器；7000=本地后端直连（vite 代理目标）；8000=artisan serve 默认端口；::1=IPv6 回环。
# 注意：列表项是「前端 SPA 所在源」而非后端地址；生产按实际前端域名覆盖本变量（如 app.example.com）
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:4000,127.0.0.1:4000,localhost:7000,127.0.0.1:7000,localhost:8000,127.0.0.1:8000,::1
# token 兼容通道有效期（分钟）：null/不设置=永不过期（仅限本地开发）；
# 生产必须设置（如 10080=7 天），token 泄露后到期自动失效。前端会话通道不受本项影响
SANCTUM_EXPIRATION=null

# ===== 广播/文件存储/队列/缓存 =====
BROADCAST_CONNECTION=log
# 文件存储磁盘：local=本地磁盘；生产接对象存储时改 s3 并配 AWS_* 项
FILESYSTEM_DISK=local
# 队列驱动：database=jobs 表（当前系统未用异步队列，保持默认即可）
QUEUE_CONNECTION=database
# 缓存驱动：database=cache 表（当前系统缓存压力小，保持默认）
CACHE_STORE=database
# CACHE_PREFIX=

# ===== 可选缓存后端（当前未使用；切换时改对应驱动项）=====
# Memcached：将 CACHE_STORE 改为 memcached 时配置
MEMCACHED_HOST=127.0.0.1
# Redis：将 SESSION_DRIVER / CACHE_STORE / QUEUE_CONNECTION 改为 redis 时配置
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== 邮件（log=写日志不真发信；生产接 SMTP 时改 smtp 并配以下 MAIL_* 项）=====
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== 对象存储（当前未使用，预留；启用 s3 磁盘时配置）=====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===== 前端注入 =====
# 注入前端构建的应用名（Vite 编译时读取，勿删）
VITE_APP_NAME="${APP_NAME}"

# ===== 系统管理 =====
# 内置管理员 admin 的口令（RbacSeeder 建号/轮换时读取，无默认值——D-19a）
# 首次 db:seed 前必须设置，否则种子抛异常终止（fail-fast，禁止通用口令兜底，AGENTS.md §8.5）；
# 既有 admin 重跑种子仅在口令不一致时按此值轮换（fail-closed：不配置则不触碰既有密码）
# 本地开发可用 ADMIN_PASSWORD=admin123（与 E2E 一致）；生产部署必须设置强口令——
# admin 为最高权限保留账号（不可删除/不可降权），弱口令即整个系统的后门
# ADMIN_PASSWORD=admin123
